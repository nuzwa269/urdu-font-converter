{
  "manifest_version": 3,
  "name": "Urdu Nastaleeq Tool",
  "version": "1.0.0",
  "description": "Render any website's Urdu text in Jameel Noori Nastaleeq with size, line-height, weight, and dark-mode controls.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "48": "icon.png", "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
